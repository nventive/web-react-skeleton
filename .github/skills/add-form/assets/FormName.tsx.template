        <TextField
          fullWidth
          onBlur={onValidate}
          autoComplete="off"
          value={__formName__.fieldName}
          onChange={(value) =>
            set__FormName__((prevState) => ({ ...prevState, fieldName: value }))
          }
          label={t("<namespace>__field_name")}
